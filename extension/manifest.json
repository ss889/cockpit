{
  "manifest_version": 3,
  "name": "JobOps AI",
  "version": "0.1.0",
  "description": "Capture the current job page into your local JobOps workspace.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Import job to JobOps",
    "default_popup": "popup.html"
  }
}